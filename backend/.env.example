# ─────────────────────────────────────────────────────────────────────────────
# EcoFleet AI – Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://ecofleet:changeme@db:5432/ecofleet

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── First Superuser (created on first startup) ────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@ecofleet.in
FIRST_SUPERUSER_PASSWORD=changeme123

# ── External APIs ─────────────────────────────────────────────────────────────
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON-encoded list of allowed origins
CORS_ORIGINS=["http://localhost:5173"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Redis (for rate-limiting / caching) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
