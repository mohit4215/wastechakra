# ─────────────────────────────────────────────────────────────────────────────
# EcoFleet AI – Frontend Environment Variables (Vite)
# Copy this file to .env and fill in real values. Never commit .env to git.
# All variables must be prefixed with VITE_ to be exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Application metadata
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=EcoFleet AI

# Feature flags (optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_SENTRY_DSN=
