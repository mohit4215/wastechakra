# ─────────────────────────────────────────────────────────────────────────────
# EcoFleet AI – Root Environment Variables Template
# Copy this file to .env and configure for your local or cloud deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend Configuration ─────────────────────────────────────────────────
# Set to 'false' in production, 'true' in development
DEBUG=false
ENVIRONMENT=production

# Database Connection URL:
# For production PostgreSQL / TimescaleDB:
#   DATABASE_URL=postgresql+asyncpg://ecofleet:your_password@localhost:5432/ecofleet
# For local development with zero external dependencies (automatic fallback):
#   DATABASE_URL=sqlite+aiosqlite:///./ecofleet.db
DATABASE_URL=postgresql+asyncpg://ecofleet:changeme@localhost:5432/ecofleet

# Security & Authentication (JWT):
# Generate a strong 32+ character random secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Superuser Seeding (created on startup if no users exist)
FIRST_SUPERUSER_EMAIL=admin@ecofleet.ai
FIRST_SUPERUSER_PASSWORD=EcoFleet@2026
FIRST_SUPERUSER_FULL_NAME=EcoFleet Administrator

# CORS Configuration:
# Comma-separated list or JSON array of allowed frontend domains
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://wastechakra.vercel.app"]

# Rate Limiting & Optional Redis
RATE_LIMIT_PER_MINUTE=100
REDIS_URL=

# External Integrations (Optional)
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# ─── Frontend (Vite) Configuration ──────────────────────────────────────────
# Base URL for backend API calls.
# In local Docker/dev proxy: leave empty or set to http://localhost:8000
# In Vercel production: set to your Railway backend URL (e.g. https://wastechakra-production.up.railway.app)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=EcoFleet AI
VITE_APP_VERSION=1.0.0
